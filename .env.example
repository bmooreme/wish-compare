APP_NAME=TappyList
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/New_York
APP_URL=https://tappylist.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development can use sqlite; production uses MariaDB.
DB_CONNECTION=sqlite
# DB_CONNECTION=mariadb
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=tappylist
# DB_USERNAME=tappylist
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@tappylist.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Affiliate programs -----------------------------------------------------
# Leave blank until approved; links still work, they just aren't tagged.
# Wrap templates use {url} for the URL-encoded destination.
AMAZON_ASSOCIATE_TAG=
WALMART_AFFILIATE_TEMPLATE=
TARGET_AFFILIATE_TEMPLATE=
BESTBUY_AFFILIATE_TEMPLATE=
BARNESANDNOBLE_AFFILIATE_TEMPLATE=
# Any other store: <KEY>_AFFILIATE_TEMPLATE, e.g. ETSY_AFFILIATE_TEMPLATE=
# Catch-all wrapper (Sovrn Commerce / Skimlinks) for stores without a program:
AFFILIATE_FALLBACK_TEMPLATE=

# --- Spam protection (Cloudflare Turnstile, optional) -----------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Product photo search (optional) ----------------------------------------
# "Choose a photo" appears for list owners once either is configured.
BESTBUY_API_KEY=
WALMART_CONSUMER_ID=
WALMART_KEY_VERSION=1
# Path to the RSA private key you registered on walmart.io (keep it outside public/)
WALMART_PRIVATE_KEY_PATH=
WALMART_PUBLISHER_ID=
